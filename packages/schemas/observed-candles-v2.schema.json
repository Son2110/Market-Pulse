{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketpulse.invalid/schemas/observed-candles-v2.schema.json",
  "title": "MarketPulse optional observed daily candle subset v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "request", "assets", "candles"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "label", "freshness", "sessionCalendar"],
      "properties": {"mode": {"const": "observed"}, "label": {"const": "OBSERVED KBS DAILY CANDLES — FRESHNESS UNKNOWN"}, "freshness": {"const": "unknown"}, "sessionCalendar": {"const": "unverified"}}
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "start", "end", "interval"],
      "properties": {"symbol": {"enum": ["FPT", "VNINDEX"]}, "start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}, "interval": {"const": "1d"}}
    },
    "assets": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "candles": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/candle"}}
  },
  "$defs": {
    "decimal": {"type": "string", "maxLength": 128, "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$(?![\\s\\S])"},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "symbol", "assetType", "currency", "unit", "timezone"],
      "properties": {"assetId": {"enum": ["VN:HOSE:FPT", "VN:INDEX:VNINDEX"]}, "symbol": {"enum": ["FPT", "VNINDEX"]}, "assetType": {"enum": ["equity", "index"]}, "currency": {"enum": ["VND", null]}, "unit": {"enum": ["VND", "index_point"]}, "timezone": {"const": "Asia/Ho_Chi_Minh"}}
    },
    "candle": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "tradingDate", "interval", "currency", "unit", "timezone", "adjustmentBasis", "open", "high", "low", "close", "volume", "volumeUnit", "providerTimeLabel", "timeProvenance", "sourceAsOf", "collectedAt", "source", "barId", "contentDigest"],
      "properties": {
        "assetId": {"enum": ["VN:HOSE:FPT", "VN:INDEX:VNINDEX"]}, "tradingDate": {"type": "string", "format": "date"}, "interval": {"const": "1d"},
        "currency": {"enum": ["VND", null]}, "unit": {"enum": ["VND", "index_point"]}, "timezone": {"const": "Asia/Ho_Chi_Minh"}, "adjustmentBasis": {"enum": ["unknown", "not_applicable"]},
        "open": {"$ref": "#/$defs/decimal"}, "high": {"$ref": "#/$defs/decimal"}, "low": {"$ref": "#/$defs/decimal"}, "close": {"$ref": "#/$defs/decimal"},
        "volume": {"type": "null"}, "volumeUnit": {"const": "not_available"},
        "providerTimeLabel": {"type": "string", "maxLength": 26, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\\.[0-9]{1,6})?)?$"},
        "timeProvenance": {"const": "provider_naive_calendar_label"}, "sourceAsOf": {"type": "null"}, "collectedAt": {"type": "string", "format": "date-time", "maxLength": 32, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
        "barId": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "contentDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "connector", "connectorVersion", "dependencyVersion", "mode"],
          "properties": {"provider": {"const": "KBS"}, "connector": {"const": "vnstock"}, "connectorVersion": {"const": "4.0.8"}, "dependencyVersion": {"const": "2.6.2"}, "mode": {"const": "observed"}}
        }
      }
    }
  }
}
