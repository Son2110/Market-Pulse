# Compose publishes application ports on 127.0.0.1 only.
API_PORT=3001
WEB_PORT=5173
MONGODB_PORT=27017
REDIS_PORT=6379

# Defaults for running the API and integration tests directly on the host.
MONGODB_URL=mongodb://127.0.0.1:27017/marketpulse
REDIS_URL=redis://127.0.0.1:6379

# Internal submission is disabled until you supply a random 32-byte secret.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Put the result in ignored .env; never commit it or print it in CI logs.
INGESTION_SECRET=
INGESTION_ENDPOINT=http://127.0.0.1:3001/internal/ingestion/deliveries
